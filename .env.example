# ==========================================================
# 星海日记 —— 环境配置示例
# 用法：把本文件复制成 .env，然后按需修改
#     cp .env.example .env
# ==========================================================

# ---------- 数据库 ----------
# 默认不填 = 用 SQLite（零配置，数据存在项目目录的 xinghai.db 里）
# 想切到 MySQL，把下面这行前面的 # 去掉并按实际账号密码修改：
#
# DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/xinghai_diary?charset=utf8mb4
#
# 注意：
#   1) charset=utf8mb4 一定要带，否则中文和 emoji 会乱码
#   2) 数据库 xinghai_diary 需要先手动建好（见 scripts/init_mysql.sql）
#   3) 密码里如果有 @ : / 等特殊字符，需要做 URL 编码（例如 @ 写成 %40）

# ---------- 照片存储 ----------
# 照片落盘目录，默认 ./uploads
# UPLOAD_DIR=./uploads

# 单张照片体积上限（MB）
MAX_UPLOAD_MB=20

# 一次最多上传多少张
MAX_PHOTOS_PER_MEMORY=50
